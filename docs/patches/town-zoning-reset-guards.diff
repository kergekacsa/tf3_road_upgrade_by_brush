+		state:subscribeToEvent(RESET_GUARDS_EVENT)
+		s.subscriptions = 3
 	end
 	if dt == nil or dt <= 0 then
 		state:set(s)
@@ -955,11 +957,18 @@
 	return true
 end
 
+-- forgets the stored demand of every town: the next pass stores the current values as the new originals
+local function resetGuards(s, _param)
+	s.guards = nil
+	return true
+end
+
 local HANDLERS = {
 	[ADD_EVENT] = addZone,
 	[REMOVE_EVENT] = removeZoneAt,
 	[UPDATE_EVENT] = updateZone,
 	[DELETE_EVENT] = deleteZone,
+	[RESET_GUARDS_EVENT] = resetGuards,
 }
 
